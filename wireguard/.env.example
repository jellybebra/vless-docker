# Use with: docker compose --env-file wireguard/.env -p wireguard -f wireguard.compose.yml ...
WG_ENDPOINT=92.246.139.113
WG_PORT=51871
WG_UI_PORT=51821
WG_BIND_IP=0.0.0.0
WG_EGRESS_IPV4=138.124.114.237
WG_INSECURE=false
# Bootstrap locally BEFORE exposing the UI; remove credentials after setup.
WG_INIT_ENABLED=true
WG_INIT_USERNAME=admin
WG_INIT_PASSWORD=
# Contains server.conf and a keys/ directory with the existing client *.key files.
WG_IMPORT_DIR=./.private/wireguard-import
