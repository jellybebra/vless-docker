EMAIL=your@email.com
SELF_SNI_DOMAIN=example.com
XUI_WEBPATH=panelpath
XUI_USERNAME=admin
XUI_PASSWORD=change_me
CF_DNS_API_TOKEN=token
REALITY_DEST=traefik:8443

# Optional: host-side Proton WireGuard config for a US (or other eligible) server.
# Empty = OpenAI uses the default outbound. Never commit its private key.
PROTON_WG_CONFIG=
# Opt-in only. Default traffic is direct unless explicitly enabled.
WARP_ENABLED=false

# Optional override when the 3x-ui subscription path or port differs.
HAPP_SUB_BASE_URL=http://vless:2096/sub/
